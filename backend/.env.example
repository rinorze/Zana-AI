ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
GROQ_API_KEY=
JWT_SECRET=replace-with-64-char-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
AGENT_USERNAME=agent
AGENT_PASSWORD=changeme
CHROMA_PERSIST_DIR=./chroma_data
DATABASE_URL=sqlite:///./zana.db
AUTO_SEED_CATALOGUE=false
CLAUDE_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant
LLM_PROVIDER_CHAIN=anthropic,gemini,groq
EMBEDDING_MODEL=text-embedding-3-small
FRONTEND_URL=http://localhost:3000

# "production" refuses to start with the default JWT_SECRET or passwords.
ENVIRONMENT=development
# Build the Chroma index on startup if it is empty (needs OPENAI_API_KEY).
AUTO_INDEX_CATALOGUE=false

# Public endpoint limits (app/middleware/rate_limit.py).
RATE_LIMIT_ENABLED=true
# Only set true behind a proxy that sets X-Forwarded-For (Hugging Face, Render).
TRUST_PROXY_HEADERS=false
CHAT_PER_MINUTE=6
CHAT_PER_IP_PER_DAY=40
CHAT_DAILY_CAP=200
SEARCH_PER_MINUTE=30
VOICE_PER_MINUTE=3
VOICE_PER_IP_PER_DAY=20
LOGIN_PER_MINUTE=5
